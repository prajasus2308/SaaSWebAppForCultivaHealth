# Copy this file to `.env` and fill in the values for your real project.

# Frontend + local Vite config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Function / server runtime
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional voice engine integration
VOICE_ENGINE_URL=https://your-voice-engine.example.com
VOICE_ENGINE_KEY=your-voice-token
